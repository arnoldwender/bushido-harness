#!/usr/bin/env sh
# The first utterance of the Bushido Harness. Wire this as your harness startup
# banner so it is the first thing emitted, before any agent acts.
#   - A fixed opening precept (the creed) is printed first.
#   - Below it, a rotating "precept of the day" from precepts.txt (samurai canon).
#     Edit precepts.txt to change or extend the rotating pool. See PRECEPTS.md.
#
# The opening precept is printed in Musashi's Japanese, with a short English
# gloss marked as a gloss. That is deliberate and it is a licence fact, not a
# style choice: the Japanese of 1645 is public domain everywhere, while every
# English translation of the Go Rin no Sho is modern and still in copyright in
# the EU. sources/musashi-go-rin-no-sho.yml carries the arithmetic.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PRECEPTS="$DIR/precepts.txt"

cat <<'EOF'

  道   THE BUSHIDO HARNESS   道

  今日は昨日の我に勝ち
  (editor's gloss: today, win against the self of yesterday)
                          — Miyamoto Musashi, Go Rin no Sho (1645)
EOF

# --- Rotating precept of the day, from precepts.txt ---
if [ -f "$PRECEPTS" ]; then
  N=$(grep -c . "$PRECEPTS")
  if [ "$N" -gt 0 ]; then
    DAY=$(date +%j | sed 's/^0*//')
    [ -z "$DAY" ] && DAY=0
    IDX=$(( (DAY % N) + 1 ))
    P=$(grep . "$PRECEPTS" | sed -n "${IDX}p")
    [ -n "$P" ] && printf '\n  \342\235\226 %s\n\n' "$P"
  fi
fi
